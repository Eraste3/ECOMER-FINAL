# PostgreSQL local ou Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ecomer?sslmode=require"

# Générer un secret fort : `openssl rand -base64 48` (ou équivalent).
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"
PORT=8000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Clustering des signalements
CLUSTERING_RADIUS_METERS=500
CLUSTERING_MIN_SAMPLES=3

# Stockage des photos de signalements sur Cloudinary (production).
# Si les 3 variables sont renseignées, les photos y sont envoyées et l'IA
# analyse l'URL publique. Sinon, repli sur le disque local (backend/uploads).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="ecomer/signalements"

# Service IA (analyse des photos de signalements par YOLO)
# Laisser vide pour désactiver l'analyse automatique
IA_SERVICE_URL="http://localhost:8501"
IA_TIMEOUT_MS=20000
# Clé API partagée entre le backend et le service IA.
# Doit être IDENTIQUE dans les deux services en production : `openssl rand -base64 32`.
IA_API_KEY=""
# Sécurité SSRF du service IA : à mettre à "1" UNIQUEMENT en dev local si le
# backend sert des photos depuis http://localhost (interdit en production).
IA_ALLOW_PRIVATE=0
