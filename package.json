{
  "name": "ecomer",
  "version": "3.0.0",
  "private": true,
  "description": "ECOMER - Plateforme de gestion environnementale (Backend + Frontend)",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && node src/server.js",
    "dev:frontend": "cd frontend && npx vite",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm start",
    "prisma:generate": "cd backend && npx prisma generate",
    "prisma:migrate": "cd backend && npx prisma migrate dev",
    "prisma:studio": "cd backend && npx prisma studio",
    "prisma:seed": "cd backend && npm run prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "workspaces": [
    "backend",
    "frontend"
  ]
}
